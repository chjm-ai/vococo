# vococo 配置模板 —— 复制为 .env 后填写(.env 已 gitignore)

# === Claude 订阅认证(M0 必填)===
# 1) 不要设 ANTHROPIC_API_KEY —— 一旦存在就走 API 按量计费,而非订阅
#    (代码启动时会主动忽略它以确保走订阅)
# 2) 长期订阅令牌:本机跑 `claude setup-token` 生成(需 Pro/Max 订阅)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# 官方端点(保持默认或不设)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# === 模型 ===
# 可选:claude-sonnet-5(速度+智能平衡,推荐日常) / claude-opus-4-8(脑子最好,吃周限额) / claude-haiku-4-5
AGENT_MODEL=claude-sonnet-5

# === 多供应商切换(可选)===
# 想用 DeepSeek / Kimi 或任意第三方 Anthropic 兼容中转?直接在 Web 设置页的
# 「模型」管理界面添加(base_url+key+model),每轮自动生效,无需重启;
# 会话里 /model 仍可临时覆盖。
# 旧版 cc-switch 桌面 App 的配置(~/.claude-hermes/config.yaml,历史遗留路径名)
# 可用一次性脚本导入:python -m vococo.gateway.migrate_cc_switch
# 只用第三方时,上面的订阅 token 可以不填。

# === 助理主人 ===
# 助理如何称呼你,注入人设与工具描述。留空默认「主人」。
VOCOCO_USER_NAME=

# === 记忆 / 画像 ===
# AI_BRAIN 根目录(载入 USER.md 画像、写回 memory/)。
# 可选:目录不存在则画像/记忆注入自动跳过,不影响其余功能;想用记忆就建这个目录。
AI_BRAIN_DIR=~/AI_BRAIN

# 单轮 agent 最大步数(防失控)
AGENT_MAX_TURNS=40

# === 安全:危险拦截 + 审批闸(PreToolUse hook)===
# DANGER_GUARD:拦灾难级命令(删根/格式化/覆写裸盘等),默认开。
DANGER_GUARD=1
# APPROVAL_GATE:对「危险但非灾难」的 5 类操作(写工作目录外、git push/reset --hard、
# rm -rf、包安装、curl|sh),在【有交互通道时(TG/Web)】弹按钮请你批准;无通道(CLI/eval/cron)
# 则放行。默认开 = 复刻 Claude Code「动手前对齐」的权限体验。设 0 = 回到纯 bypass 自动执行。
APPROVAL_GATE=1

# === Skill 加载范围 ===
# 默认(留空)全量挂载 ~/.claude 下所有 skill —— ~110 个,tool schema 偏大、费 token。
# 建议配白名单只挂常用的(逗号或空格分隔,名字 = SKILL.md 的 name / 目录名);
# 填 all 显式全部。示例:
# AGENT_SKILLS=monthly-planner,things-assistant,audio-processor,email-sender,deep-research
AGENT_SKILLS=

# === 会话统一(跨入口连续)===
# 1=CLI/TUI/Telegram/飞书 共享同一会话(飞书问一半切 CLI 接着聊);0=按平台隔离
UNIFY_SESSIONS=1
SESSION_KEY=main

# === 记忆晋升:定时反思(把会话沉淀成长期记忆)===
# 1=开启:按 REFLECT_CRON 定时回顾统一会话,让助手自主用 save_memory 沉淀(会消耗额度)
REFLECT_ENABLED=0
# cron 表达式(默认每天 23:00)
REFLECT_CRON=0 23 * * *
# 反思结果推送到哪(可选,platform:chat_id,如 telegram:123456789);留空只写日志
REFLECT_TARGET=

# === Telegram(可选,跑 `vococo telegram` 时需要)===
# 1) 在 Telegram 找 @BotFather 发 /newbot,拿到 bot token
TELEGRAM_BOT_TOKEN=
# 2) 只允许这些 chat_id 跟 bot 聊(个人 bot 强烈建议设)。
#    不知道自己 id?先留空启动,给 bot 发条消息,控制台会打印你的 chat_id。
#    多个用逗号:TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=
# 白名单留空时的姿态:默认【拒收一切】(fail-closed,防陌生人搜到 bot 就能驱动 Claude)。
# 真要「谁都能聊」必须显式设 1——这是危险选项,需要你主动打开。
TELEGRAM_ALLOW_ALL=0

# === Web 渠道(手机浏览器访问,自建 UI,可选)===
# 1=启用:serve 时同进程起一个网页服务(SSE 流式 + 会话侧边栏)。
WEB_ENABLED=0
# 只监听本机;靠 Cloudflare Tunnel / Tailscale 安全暴露到公网(自带 HTTPS)。
# 想在同一 WiFi 下直接用 Mac 局域网 IP 访问,可改成 0.0.0.0(仅内网,别裸奔公网)。
WEB_HOST=127.0.0.1
WEB_PORT=8848
# 访问口令:强烈建议设一个(随机字符串)。一旦走公网,没口令 = 任何人能用你的订阅。
# 手机首次打开输入一次,浏览器记住;之后免输。
# 注:WEB_HOST 绑非本机(0.0.0.0/局域网 IP)却没设本口令时,serve 会【拒绝启动】(fail-closed)。
WEB_AUTH_TOKEN=
# 是否允许从网页设置页注册「本地 stdio MCP」(command 会被当子进程拉起 = 远程 RCE 风险)。
# 默认 0 禁止;确需再设 1。sse/http 型 MCP 不受此限。
WEB_ALLOW_STDIO_MCP=0

# === Web Push 系统通知(把网页装到主屏后,页面关了/锁屏也能收到)===
# iOS 16.4+:必须先把网页「添加到主屏幕」,从主屏图标打开才能开启。
# 生成密钥(填下面两行):python -m vococo.gateway.adapters.web_push --gen-keys
# 两行都留空 = 通知功能自动关闭(前端连开关都不显示),不影响其余功能。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# 四种通知场景各自开关(默认全开;某类嫌吵就设 0):
# 回复完成 / 需要审批确认 / 主动推送(cron) / 出错异常
PUSH_ON_DONE=1
PUSH_ON_APPROVAL=1
PUSH_ON_PROACTIVE=1
PUSH_ON_ERROR=1
