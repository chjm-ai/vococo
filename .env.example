# claude-hermes 配置模板 —— 复制为 .env 后填写(.env 已 gitignore)

# === Claude 订阅认证(M0 必填)===
# 1) 不要设 ANTHROPIC_API_KEY —— 一旦存在就走 API 按量计费,而非订阅
#    (代码启动时会主动忽略它以确保走订阅)
# 2) 长期订阅令牌:本机跑 `claude setup-token` 生成(需 Pro/Max 订阅)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# 官方端点(保持默认或不设)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# === 模型 ===
# 可选:claude-opus-4-8(脑子最好,吃周限额) / claude-sonnet-4-6(更省) / claude-haiku-4-5
AGENT_MODEL=claude-opus-4-8

# === 记忆 / 画像 ===
# AI_BRAIN 根目录(载入 USER.md 画像、写回 memory/)
AI_BRAIN_DIR=~/AI_BRAIN

# 单轮 agent 最大步数(防失控)
AGENT_MAX_TURNS=40
