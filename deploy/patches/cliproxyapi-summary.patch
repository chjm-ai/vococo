diff --git a/internal/thinking/vococo_summary_test.go b/internal/thinking/vococo_summary_test.go
new file mode 100644
index 0000000..d189aa0
--- /dev/null
+++ b/internal/thinking/vococo_summary_test.go
@@ -0,0 +1,35 @@
+package thinking
+
+import (
+	"github.com/tidwall/gjson"
+	"testing"
+)
+
+func TestVococoClaudeGPTSummary(t *testing.T) {
+	for _, level := range []string{"auto", "concise", "detailed", "none", "", "invalid"} {
+		source := []byte(`{"model":"gpt-6.1-sol","thinking":{"type":"adaptive","display":"summarized"},"reasoning":{"summary":"` + level + `"}}`)
+		config := ExtractSummaryConfig(source, "claude")
+		expected := level
+		if level == "none" {
+			expected = ""
+		}
+		if level == "" || level == "invalid" {
+			expected = "auto"
+		}
+		body := ApplySummaryConfig([]byte(`{"reasoning":{"effort":"high"}}`), "codex", config)
+		if got := gjson.GetBytes(body, "reasoning.summary").String(); got != expected {
+			t.Fatalf("level=%q: got %q, want %q", level, got, expected)
+		}
+		if gjson.GetBytes(body, "reasoning.effort").String() != "high" {
+			t.Fatal("effort changed")
+		}
+	}
+	disabled := ExtractSummaryConfig([]byte(`{"model":"gpt-6.1-sol","reasoning":{"summary":null}}`), "claude")
+	if disabled.Mode != SummaryDisabled {
+		t.Fatal("null must explicitly disable summary")
+	}
+	nonGPT := ExtractSummaryConfig([]byte(`{"model":"claude-sonnet-5-5","reasoning":{"summary":"detailed"}}`), "claude")
+	if nonGPT.Mode != SummaryUnspecified {
+		t.Fatal("non-GPT must ignore extension")
+	}
+}
