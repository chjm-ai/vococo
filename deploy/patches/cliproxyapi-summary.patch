@@ -0,0 +1,34 @@
+package claude
+
+import (
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+	"testing"
+)
+
+func TestVococoSummaryRegistryToResponses(t *testing.T) {
+	for _, level := range []string{"auto", "concise", "detailed", "none"} {
+		rawLevel := `"` + level + `"`
+		if level == "none" {
+			rawLevel = "null"
+		}
+		source := []byte(`{"model":"gpt-6.1-sol","messages":[{"role":"user","content":"hi"}],"thinking":{"type":"adaptive","display":"summarized"},"output_config":{"effort":"high"},"text":{"verbosity":"low"},"reasoning":{"summary":` + rawLevel + `}}`)
+		out := sdktranslator.TranslateRequest(sdktranslator.FormatClaude, sdktranslator.FormatCodex, "gpt-6.1-sol", source, true)
+		expected := level
+		if level == "none" {
+			expected = ""
+		}
+		if got := gjson.GetBytes(out, "reasoning.summary").String(); got != expected {
+			t.Fatalf("summary %q: got %q", level, got)
+		}
+		if gjson.GetBytes(out, "reasoning.effort").String() != "high" {
+			t.Fatal("effort changed")
+		}
+		if gjson.GetBytes(out, "text.verbosity").String() != "low" {
+			t.Fatal("verbosity lost")
+		}
+		if level == "none" && gjson.GetBytes(out, "reasoning.summary").Exists() {
+			t.Fatal("disabled must omit field")
+		}
+	}
+}
