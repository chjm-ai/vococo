diff --git a/internal/translator/codex/claude/vococo_verbosity_test.go b/internal/translator/codex/claude/vococo_verbosity_test.go
new file mode 100644
index 0000000..4d8b318
--- /dev/null
+++ b/internal/translator/codex/claude/vococo_verbosity_test.go
@@ -0,0 +1,33 @@
+package claude
+
+import (
+	"github.com/tidwall/gjson"
+	"testing"
+)
+
+func TestVococoVerbosity(t *testing.T) {
+	for _, value := range []string{"low", "medium", "high", "", "invalid"} {
+		input := []byte(`{"messages":[{"role":"user","content":"hi"}],"text":{"verbosity":"` + value + `"},"thinking":{"type":"adaptive"},"output_config":{"effort":"high"}}`)
+		output, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", input, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := value
+		if value == "invalid" {
+			want = ""
+		}
+		if got := gjson.GetBytes(output, "text.verbosity").String(); got != want {
+			t.Fatalf("verbosity=%q: got %q, want %q", value, got, want)
+		}
+		if value == "" && gjson.GetBytes(output, "text.verbosity").Exists() {
+			t.Fatal("default must omit verbosity")
+		}
+		output, err = ConvertClaudeRequestToCodex("deepseek-flash", input, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if gjson.GetBytes(output, "text.verbosity").Exists() {
+			t.Fatal("non-GPT received verbosity")
+		}
+	}
+}
